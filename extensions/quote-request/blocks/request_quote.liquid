{%- liquid
  assign qc_collection = block.settings.collection
  assign qc_product = block.settings.product
  assign qc_limit = block.settings.product_limit | default: 20

  # A collection wins when it is set and actually has products; otherwise the
  # block falls back to the single product it has always supported, so existing
  # installs keep working untouched.
  assign qc_use_collection = false
  if qc_collection != blank and qc_collection.products.size > 0
    assign qc_use_collection = true
  endif

  assign qc_has_products = qc_use_collection
  if qc_product != blank
    assign qc_has_products = true
  endif

  # Colours. Shopify does not allow a color_scheme setting in an app block
  # (https://shopify.dev/docs/storefronts/themes/architecture/settings/input-settings),
  # so the merchant picks a mode instead: keep the app's warm palette, let the
  # form inherit the theme's own colours, or set a surface and text colour by
  # hand. "warm" is the default, so an untouched block looks exactly as before.
  assign qc_color_style = block.settings.color_style | default: 'warm'

  # Normalised to a hex string first: the filters below take one, and this way a
  # cleared setting and a picked colour both arrive in the same shape.
  assign qc_accent = block.settings.accent_color | default: '#a4552b' | color_to_hex
  assign qc_accent_strong = qc_accent | color_darken: 8

  # Whether the button label should be white or near-black. Shopify recommends a
  # brightness difference of at least 125, so take whichever side of the accent
  # gives the larger one rather than assuming white survives every colour a
  # merchant might pick.
  assign qc_gap_white = qc_accent | brightness_difference: '#ffffff'
  assign qc_gap_dark = qc_accent | brightness_difference: '#1f1f1f'
  assign qc_on_accent = '#ffffff'
  if qc_gap_dark > qc_gap_white
    assign qc_on_accent = '#1f1f1f'
  endif
-%}

{%- comment -%}
  "theme" and "custom" both derive their greys from the text colour in play, so
  they share the --adaptive modifier; only "custom" paints a surface of its own.
{%- endcomment -%}
{%- capture qc_class -%}
quotecrate-form
{%- if qc_color_style == 'theme' %} quotecrate-form--theme quotecrate-form--adaptive{% endif -%}
{%- if qc_color_style == 'custom' %} quotecrate-form--custom quotecrate-form--adaptive{% endif -%}
{%- endcapture -%}

{%- capture qc_inline_style -%}
--qc-accent: {{ qc_accent }}; --qc-accent-strong: {{ qc_accent_strong }}; --qc-on-accent: {{ qc_on_accent }};
{%- if qc_color_style == 'custom' %} --qc-surface: {{ block.settings.bg_color | default: '#fffdf9' }}; --qc-text: {{ block.settings.text_color | default: '#3b2416' }};{% endif -%}
{%- endcapture -%}

{%- unless qc_has_products -%}
  {%- comment -%}
    Nothing to quote. In the theme editor the merchant still needs to see the
    block, so show a hint there instead of rendering an unusable form.
  {%- endcomment -%}
  {%- if request.design_mode -%}
    <div class="{{ qc_class }} quotecrate-form--empty" style="{{ qc_inline_style }}">
      Choose a collection, or a single product, for this block in the theme
      editor to show the quote form.
    </div>
  {%- endif -%}
{%- else -%}
  <div class="{{ qc_class }}" style="{{ qc_inline_style }}" data-quotecrate-block>
    {%- comment -%}
      In the warm default this is a dark band, matching the buyer quote page at
      app/routes/apps.quotecrate.quote.tsx so a shopper sees one design from
      request through to acceptance. In the theme-matching modes it flattens to
      a ruled header so it cannot fight the merchant's own section colours.
    {%- endcomment -%}
    <div class="quotecrate-form__header">
      {%- if block.settings.badge != blank -%}
        <span class="quotecrate-form__badge">{{ block.settings.badge }}</span>
      {%- endif -%}

      <h2 class="quotecrate-form__heading">{{ block.settings.heading }}</h2>

      {%- if block.settings.description != blank -%}
        <p class="quotecrate-form__description">{{ block.settings.description }}</p>
      {%- endif -%}
    </div>

    <form
      class="quotecrate-form__form"
      data-quotecrate-form
      data-endpoint="{{ block.settings.proxy_path }}"
    >
      <div class="quotecrate-form__row">
        <div class="quotecrate-form__field">
          <label for="quotecrate-name-{{ block.id }}">Your name</label>
          <input
            type="text"
            id="quotecrate-name-{{ block.id }}"
            name="customerName"
            autocomplete="name"
            required
          >
        </div>

        <div class="quotecrate-form__field">
          <label for="quotecrate-email-{{ block.id }}">Email</label>
          <input
            type="email"
            id="quotecrate-email-{{ block.id }}"
            name="customerEmail"
            autocomplete="email"
            required
          >
        </div>
      </div>

      <div class="quotecrate-form__field">
        <label for="quotecrate-company-{{ block.id }}">
          Company <span>(optional)</span>
        </label>
        <input
          type="text"
          id="quotecrate-company-{{ block.id }}"
          name="company"
          autocomplete="organization"
        >
      </div>

      <div class="quotecrate-form__items">
        {%- if qc_use_collection -%}
          <span class="quotecrate-form__items-label">Products</span>
          <p class="quotecrate-form__items-hint">
            Enter a quantity for each product you want quoted. Leave the rest blank.
          </p>

          {%- comment -%}
            A Liquid for loop runs at most 50 iterations, so the range setting
            below is capped at 50 too — the list can never silently truncate
            below what the merchant chose.
          {%- endcomment -%}
          {%- for qc_item_product in qc_collection.products limit: qc_limit -%}
            {%- render 'quote-request-item',
              item_product: qc_item_product,
              block_id: block.id,
              item_index: forloop.index,
              item_quantity: ''
            -%}
          {%- endfor -%}
        {%- else -%}
          <span class="quotecrate-form__items-label">Product</span>

          {%- render 'quote-request-item',
            item_product: qc_product,
            block_id: block.id,
            item_index: 1,
            item_quantity: 1
          -%}
        {%- endif -%}
      </div>

      <div class="quotecrate-form__field">
        <label for="quotecrate-note-{{ block.id }}">
          Note to the seller <span>(optional)</span>
        </label>
        <textarea id="quotecrate-note-{{ block.id }}" name="note" rows="3"></textarea>
      </div>

      <button type="submit" class="quotecrate-form__submit">
        {{ block.settings.button_label }}
      </button>

      <p class="quotecrate-form__subnote">
        No payment now — you&rsquo;ll review pricing first
      </p>

      <p class="quotecrate-form__assurance">
        🔒 We&rsquo;ll only use this to send your quote
      </p>

      <p class="quotecrate-form__message" data-quotecrate-message role="status" aria-live="polite" hidden></p>

      <p class="quotecrate-form__footer">Powered by QuoteCrate</p>
    </form>
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "Request a Quote",
  "target": "section",
  "stylesheet": "quote-request.css",
  "javascript": "quote-request.js",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Wholesale collection",
      "info": "Shoppers can request a quote for any product in this collection, each with its own quantity. Leave empty to quote a single product instead."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum products to show",
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 20,
      "info": "Liquid can loop over at most 50 products, so 50 is the ceiling."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Single product",
      "info": "Used only when no collection is selected.",
      "autofill": true
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "info": "Small label above the heading. Leave empty to hide it.",
      "default": "Wholesale"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Request a quote"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "Add your own reply time here if you want to promise one — for example \"We'll send pricing within 2 business days.\" The default deliberately promises nothing, because only you know how fast you can answer.",
      "default": "Tell us what you need and we'll send you a price."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send quote request"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_style",
      "label": "Color style",
      "options": [
        { "value": "warm", "label": "QuoteCrate warm" },
        { "value": "theme", "label": "Match my theme" },
        { "value": "custom", "label": "Custom colors" }
      ],
      "default": "warm",
      "info": "\"Match my theme\" leaves the form unpainted, so it takes the background and text color of the section around it. That is the safest choice on a dark or strongly colored theme."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#fffdf9",
      "info": "Used only with \"Custom colors\"."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3b2416",
      "info": "Used only with \"Custom colors\". Pick one with strong contrast against the background above."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button and focus color",
      "default": "#a4552b",
      "info": "Used in every color style. The button label switches between white and near-black on its own, whichever is easier to read."
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "info": "Must match the app proxy prefix and subpath configured for this app.",
      "default": "/apps/quotecrate/quote-request"
    }
  ]
}
{% endschema %}
