// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/**
 * Per-shop facts the app has to know when there is no admin request in flight.
 *
 * The storefront quote-request endpoint runs for a shopper, not a merchant, so
 * every Admin API call it makes is a live call over the offline token that can
 * fail for reasons the shopper cannot see and the merchant cannot fix. Caching
 * the answer here turns that into a read of our own database, and a value that
 * was true the last time we could ask is far better than a wrong default.
 */
model ShopSetting {
  shop      String   @id
  // The three letter code the shop sells in, mirrored from Admin
  // `shop { currencyCode }`.
  currency  String
  // When the currency was last confirmed against Shopify.
  //
  // Explicit rather than the row's `updatedAt`: the row now carries a second
  // cached fact with its own refresh cycle, and `@updatedAt` bumps on any write.
  // Reading freshness off it would mean a name refresh silently marked the
  // currency fresh too, and the currency would stop being re-read at all.
  currencyUpdatedAt DateTime @default(now())
  // The shop's own name — "Acme Coffee Roasters", not "acme-coffee" — mirrored
  // from Admin `shop { name }`. Buyers see this on their quote page and in the
  // quote email, so it must be the name the merchant trades under rather than
  // the myshopify subdomain. Null until it has been read once.
  name      String?
  // The storefront the buyer can reach the merchant through, mirrored from Admin
  // `shop { primaryDomain { url } }`. The buyer's quote page tells them to
  // contact the store in several states, and this is what that links to. A
  // public storefront URL is safe to show; the shop account email is not, since
  // it can be the owner's personal address.
  primaryDomainUrl String?
  // When the cached profile above was last confirmed. Both fields are written
  // together by one query, so one timestamp covers them. Null until then.
  profileUpdatedAt DateTime?
  updatedAt DateTime @updatedAt
}

model Quote {
  id            String   @id @default(cuid())
  shop          String
  customerName  String
  customerEmail String
  company       String?
  // REQUESTED|QUOTED|ACCEPTED|DECLINED|CONVERTED|EXPIRED
  // String rather than enum because SQLite has no native enum type.
  status        String   @default("REQUESTED")
  currency      String   @default("USD")
  // What the buyer wrote for the merchant when they asked for the quote.
  // Storefront input, capped at 2000 characters by the request endpoint.
  note          String?
  // Whole minor units of `currency` — won for KRW, cents for USD, fils for
  // BHD. The scale is the currency's own (see currencyDecimals in app/quotes.ts),
  // never a fixed 100. BigInt rather than Int so a large total has room even in
  // a currency with many minor units per major one.
  quotedTotalMinor BigInt?
  // Unguessable token that lets the buyer open this one quote on the
  // storefront without logging in. Null until the quote is sent, so an
  // unpriced REQUESTED quote has no public URL at all.
  publicToken   String?  @unique
  // Unique so the same Shopify draft order can never be recorded against two
  // quotes: a retry that got as far as creating the order, or a future recovery
  // path, would otherwise be able to attach one order to a second quote and
  // invoice the buyer twice for it. SQLite treats NULLs as distinct, so the
  // many unconverted quotes are unaffected.
  draftOrderId  String?  @unique
  // Checkout link returned by draftOrderCreate; the merchant sends this to the
  // buyer so they can pay the quoted price.
  invoiceUrl    String?
  // When the "your quote is ready" email was last sent to the customer.
  //
  // Claimed with a compare-and-set before the mail is handed to Resend, so two
  // sends racing each other (a double click, or two admin tabs) cannot both
  // deliver. Cleared again when the send fails, so a retry is never blocked by
  // an attempt that produced no email. Null means the customer has never been
  // emailed this quote.
  quoteEmailSentAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         QuoteItem[]
  // Everything said about this quote *after* the request came in. The buyer's
  // original `note` is deliberately not moved in here — see QuoteMessage.
  messages      QuoteMessage[]

  @@index([shop, status])
  // Backs the flood check the public quote-request endpoint runs before it
  // writes: "how many quotes has this address filed at this shop recently".
  @@index([shop, customerEmail, createdAt])
}

/** Who wrote a message. Both sides of one conversation, so one column. */
enum QuoteMessageAuthor {
  CUSTOMER
  MERCHANT
}

/**
 * One message in the conversation attached to a quote.
 *
 * A quote is a negotiation, and a negotiation is a back-and-forth: the buyer
 * asks whether the lead time can be shortened, the merchant answers, the buyer
 * accepts. This replaces the single `Quote.sellerNote` that came before it,
 * which could hold exactly one sentence from exactly one side and was
 * overwritten by the next send.
 *
 * `Quote.note` — the note the buyer typed on the storefront request form — is
 * deliberately NOT copied in here. It is already the first thing said about this
 * quote, and it is stored on the quote itself because the merchant notification
 * email and the Shopify draft order both read it from there. Copying it would
 * give it two homes that can disagree; instead both pages prepend it to the
 * thread when they render (see buildThread in app/quote-thread.server.ts), which
 * is a view concern and costs no write at all.
 */
model QuoteMessage {
  id        String             @id @default(cuid())
  quoteId   String
  quote     Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  author    QuoteMessageAuthor
  // Free text, capped by the writing endpoints at MESSAGE_MAX_LENGTH.
  body      String
  // What makes "the same message twice" a thing the database can refuse.
  //
  // Derived from the author, a digest of the body and a coarse time bucket (see
  // dedupeKey in app/quote-thread.server.ts). The buyer's reply form works with
  // JavaScript off, so nothing on the client stops a double submit or a reloaded
  // POST, and every message that lands emails the other side — a duplicate is
  // two emails for one sentence, not a cosmetic blemish.
  //
  // A unique index rather than a read-then-insert: two submissions arriving
  // together would both find nothing and both write. This is the same
  // "let the database decide the race" approach the conversion paths take with
  // their compare-and-set updates.
  dedupeKey String
  createdAt DateTime           @default(now())

  // The thread is always read whole and in order, for one quote at a time.
  @@index([quoteId, createdAt])
  @@unique([quoteId, dedupeKey])
}

model QuoteItem {
  id                   String  @id @default(cuid())
  quoteId              String
  quote                Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId            String?
  variantId            String?
  title                String
  variantTitle         String?
  quantity             Int
  // Whole minor units of the parent quote's currency, same convention as
  // Quote.quotedTotalMinor.
  quotedUnitPriceMinor BigInt?

  @@index([quoteId])
}
